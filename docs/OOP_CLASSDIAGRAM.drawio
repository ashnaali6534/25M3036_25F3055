        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class Enum_WordRow {\n        ROW_WORD1\n        ROW_WORD2\n        +values() void\n    }\n    class Enum_GameState {\n        GAME_MENU\n        GAME_PLAYING\n        GAME_WON\n        GAME_LOST\n        GAME_EXIT\n        +values() void\n    }\n    class Enum_MenuChoice {\n        CHOICE_NEW_GAME\n        CHOICE_SCOREBOARD\n        CHOICE_ABOUT\n        CHOICE_RULES\n        CHOICE_EXIT\n        +values() void\n    }\n    class Enum_Tint {\n        TINT_BLACK\n        TINT_BLUE\n        TINT_GREEN\n        TINT_CYAN\n        TINT_RED\n        TINT_PURPLE\n        TINT_YELLOW\n        TINT_WHITE\n        TINT_GRAY\n        TINT_LBLUE\n        TINT_LGREEN\n        TINT_LCYAN\n        TINT_LRED\n        TINT_PINK\n        TINT_GOLD\n        TINT_BWHITE\n        +values() void\n    }\n\n    class Tile {\n        +char tileLetter\n        +bool filled\n        +Tile()\n        +Tile(char, bool)\n        +operator_insertion(ostream, Tile) ostream\n        +operator_extraction(istream, Tile) istream\n        +operator_equals(Tile, Tile) bool\n    }\n    class Clue {\n        +char clueLetter\n        +int cluePosition\n        +Enum_WordRow clueRow\n        +Clue()\n        +Clue(char, int, Enum_WordRow)\n        +operator_equals(Clue, Clue) bool\n    }\n    class Location {\n        +string locName\n        +char letterClueLoc\n        +int boardPosLoc\n        +Enum_WordRow locRow\n        +bool locSearchFlag\n        +Location()\n        +operator_insertion(ostream, Location) ostream\n        +operator_extraction(istream, Location) istream\n    }\n\n    class GameException {\n        #string message\n        +GameException(string)\n        +dtor()\n        +getMessage() string\n        +show() void\n    }\n    class InvalidWordException {\n        #string message\n        +InvalidWordException(string)\n    }\n    class RackFullException {\n        #string message\n        +RackFullException(string)\n    }\n    class RackEmptyException {\n        #string message\n        +RackEmptyException(string)\n    }\n    class InvalidPositionException {\n        #string message\n        +InvalidPositionException(string)\n    }\n    class SlotFilledException {\n        #string message\n        +SlotFilledException(string)\n    }\n    class InvalidInputException {\n        #string message\n        +InvalidInputException(string)\n    }\n    class FileException {\n        #string message\n        +FileException(string)\n    }\n    class LockedCharacterException {\n        #string message\n        +LockedCharacterException(string)\n    }\n    class WrongAccusationException {\n        #string message\n        +WrongAccusationException(string)\n    }\n\n    class ConsoleUI {\n        +bool staticOnly\n        +init() void\n        +setColor(int) void\n        +resetColor() void\n        +clearScreen() void\n        +delay(int) void\n        +beep(int, int) void\n        +printChar(int, int) void\n        +boxTop(int, int) void\n        +boxDivider(int, int) void\n        +boxBottom(int, int) void\n        +boxLine(string, int, int, int, bool) void\n        +typeText(string, int, int) void\n        +bigText(string, int) void\n        +progressBar(int, int, int, int) void\n        +readLine() string\n        +readChoice(string, int, int) int\n        +askYesNo(string) bool\n        +pause() void\n        +trim(string) string\n        +toUpper(string) string\n        +prettyName(string) string\n        +pad(string, int) string\n        +intToStr(int, int) string\n        +parseInt(string, bool) int\n        +splitLine(string, string, int) int\n        +nextDataLine(ifstream, string) bool\n    }\n\n    class DynamicArray~T~ {\n        -T_ptr data\n        -int size\n        -int capacity\n        -grow(int) void\n        +DynamicArray(int)\n        +DynamicArray(DynamicArray)\n        +operator_assign(DynamicArray) DynamicArray\n        +dtor()\n        +add(T) void\n        +resize(int) void\n        +removeAt(int) void\n        +clear() void\n        +getSize() int\n        +operator_index(int) T\n    }\n\n    class TileRack {\n        -DynamicArray~Tile~ tiles\n        -DynamicArray~int~ positions\n        -int maxSize\n        +TileRack(int)\n        +TileRack(TileRack)\n        +operator_assign(TileRack) TileRack\n        +dtor()\n        +addTile(Clue) void\n        +removeTile(int) Tile\n        +isFull() bool\n        +isEmpty() bool\n        +getCount() int\n        +clear() void\n        +display() void\n        +operator_plus(TileRack) TileRack\n    }\n    class Cottage {\n        -DynamicArray~Location~ locCache\n        +int TOTAL_LOCATIONS\n        +Cottage()\n        +Cottage(Cottage)\n        +operator_assign(Cottage) Cottage\n        +dtor()\n        +loadFromFile(string, int) void\n        +getLocationCount() int\n        +isSearched(int) bool\n        +getLocationName(int) string\n        +getClue(int) Clue\n        +markSearched(int) void\n        +displayMenu() void\n        +displayMap() void\n    }\n    class Scrabble {\n        -DynamicArray~Tile~ row1\n        -DynamicArray~Tile~ row2\n        -string target1\n        -string target2\n        -bool solved1\n        -bool solved2\n        +int ROW1_SIZE\n        +int ROW2_SIZE\n        -displayRow(Enum_WordRow) void\n        +Scrabble()\n        +Scrabble(Scrabble)\n        +operator_assign(Scrabble) Scrabble\n        +dtor()\n        +loadWords(string, string) void\n        +placeLetter(Clue) void\n        +isRowComplete(Enum_WordRow) bool\n        +isRowSolved(Enum_WordRow) bool\n        +isBothSolved() bool\n        +checkWord(Enum_WordRow, string) bool\n        +getRowWord(Enum_WordRow) string\n        +display() void\n        +operator_insertion(ostream, Scrabble) ostream\n        +operator_extraction(istream, Scrabble) istream\n    }\n\n    class Character {\n        -string characterName\n        -string characterRole\n        -string nationality\n        -bool isCulprit\n        -bool interviewed\n        #showCard(int, string) void\n        +Character(string, string, string)\n        +dtor()\n        +display() void\n        +getRequiredCredibility() int\n        +getClue() Clue\n        +setClue(char, int, Enum_WordRow) void\n        +isSuspectRole() bool\n        +getName() string\n        +getRole() string\n        +getNationality() string\n        +getIsCulprit() bool\n        +isInterviewed() bool\n        +setName(string) void\n        +operator_insertion(ostream, Character) ostream\n        +operator_extraction(istream, Character) istream\n    }\n    class Victim {\n        -Enum_WordRow clueRowChar\n        -char letterClueChar\n        -int boardPosChar\n        +Victim(string, string)\n        +dtor()\n        +display() void\n        +getRequiredCredibility() int\n        +getClue() Clue\n        +setClue(char, int, Enum_WordRow) void\n    }\n    class Detective {\n        -int credibility\n        -int turns\n        -TileRack rackWord1\n        -TileRack rackWord2\n        +Detective(string, int)\n        +dtor()\n        +display() void\n        +reset(string, int) void\n        +getCredibility() int\n        +getTurns() int\n        +loseCredibility(int) void\n        +useTurn() void\n        +getRack(Enum_WordRow) TileRack\n    }\n    class Suspect {\n        #Enum_WordRow clueRowChar\n        #char letterClueChar\n        #int boardPosChar\n        +Suspect(string, string, string)\n        +dtor()\n        +getClue() Clue\n        +setClue(char, int, Enum_WordRow) void\n        +isSuspectRole() bool\n    }\n    class BusinessRelations {\n        #Enum_WordRow clueRowChar\n        +BusinessRelations(string, string, string)\n        +dtor()\n    }\n    class CloseRelations {\n        #Enum_WordRow clueRowChar\n        +CloseRelations(string, string, string)\n        +dtor()\n    }\n    class HouseHelp {\n        #Enum_WordRow clueRowChar\n        +HouseHelp(string, string, string)\n        +dtor()\n    }\n    class Partner {\n        #Enum_WordRow clueRowChar\n        +Partner(string, string, string)\n        +dtor()\n        +display() void\n        +getRequiredCredibility() int\n    }\n    class PA {\n        #Enum_WordRow clueRowChar\n        +PA(string, string)\n        +dtor()\n        +display() void\n        +getRequiredCredibility() int\n    }\n    class Cook {\n        #Enum_WordRow clueRowChar\n        +Cook(string, string)\n        +dtor()\n        +display() void\n    }\n    class Guard {\n        #Enum_WordRow clueRowChar\n        +Guard(string, string)\n        +dtor()\n        +display() void\n    }\n    class Servant {\n        #Enum_WordRow clueRowChar\n        +Servant(string, string)\n        +dtor()\n        +display() void\n    }\n    class OwnersChild {\n        #Enum_WordRow clueRowChar\n        +OwnersChild(string, string)\n        +dtor()\n        +display() void\n        +getRequiredCredibility() int\n    }\n\n    class ScoreBoard {\n        -string fileName\n        -todayDate() string\n        +ScoreBoard(string)\n        +addScore(string, string, int, int, string) void\n        +displayAll() void\n    }\n\n    class GameEngine {\n        -GameEngine_ptr instance\n        -int MAX_PEOPLE\n        -Enum_GameState state\n        -Detective detective\n        -Cottage cottage\n        -Scrabble scrabble\n        -TileRack clueRack\n        -ScoreBoard_ptr scoreBoard\n        -Character_ptr people\n        -int peopleCount\n        -int maxTurns\n        -int startCredibility\n        -int wrongTurnPenalty\n        -int wrongWordPenalty\n        -string winCondition\n        -string loseCondition\n        -string culpritRole\n        -GameEngine(ScoreBoard_ptr)\n        -GameEngine(GameEngine)\n        -operator_assign(GameEngine) GameEngine\n        -freePeople() void\n        -createCharacter(string, string, string) Character_ptr\n        -loadRules() bool\n        -loadClueFile(int, string, string, string) void\n        -loadCharacters(int, string) void\n        -readDetectiveName() string\n        -startNewGame() void\n        -menuStep() void\n        -playStep() void\n        -showMainMenu() void\n        -showGameMenu() void\n        -showHUD() void\n        -showAbout() void\n        -showRules() void\n        -showScoreBoardScreen() void\n        -showBoardScreen() void\n        -finishGame() void\n        -visitLocation() void\n        -interviewPerson() void\n        -formWord() void\n        -accuseSuspect() void\n        -quitGame() void\n        -spendTurn() void\n        -checkEnd() void\n        -flashLetter(Clue, string) void\n        -findCulprit() Character_ptr\n        +getInstance(ScoreBoard_ptr) GameEngine_ptr\n        +destroyInstance() void\n        +dtor()\n        +showWelcome() void\n        +step() void\n        +isRunning() bool\n    }\n\n    GameException &lt;|-- InvalidWordException\n    GameException &lt;|-- RackFullException\n    GameException &lt;|-- RackEmptyException\n    GameException &lt;|-- InvalidPositionException\n    GameException &lt;|-- SlotFilledException\n    GameException &lt;|-- InvalidInputException\n    GameException &lt;|-- FileException\n    GameException &lt;|-- LockedCharacterException\n    GameException &lt;|-- WrongAccusationException\n\n    Character &lt;|-- Victim\n    Character &lt;|-- Detective\n    Character &lt;|-- Suspect\n    Suspect &lt;|-- BusinessRelations\n    Suspect &lt;|-- CloseRelations\n    Suspect &lt;|-- HouseHelp\n    BusinessRelations &lt;|-- Partner\n    BusinessRelations &lt;|-- PA\n    CloseRelations &lt;|-- PA\n    CloseRelations &lt;|-- OwnersChild\n    HouseHelp &lt;|-- Cook\n    HouseHelp &lt;|-- Guard\n    HouseHelp &lt;|-- Servant\n\n    GameEngine \&quot;1\&quot; *-- \&quot;1\&quot; Detective\n    GameEngine \&quot;1\&quot; *-- \&quot;1\&quot; Cottage\n    GameEngine \&quot;1\&quot; *-- \&quot;1\&quot; Scrabble\n    GameEngine \&quot;1\&quot; *-- \&quot;1\&quot; TileRack\n    Ga